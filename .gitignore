# ==========================================
# DonerHQ - Unified root-level .gitignore
# ==========================================

# ------------------------------------------
# 1. Platform Prep & Study Files
# ------------------------------------------
donerhq_backend_handbook.md
donerhq_client_architecture.md
donerhq_interview_guide.md
donerhq_server_architecture.md
donerhq_weak_points_guide.md
project_deep_dive.md

# ------------------------------------------
# 2. Dependency Directories (Recursive)
# ------------------------------------------
**/node_modules/
node_modules/

# ------------------------------------------
# 3. Environment & Configuration Files
# ------------------------------------------
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
.env
.env.local

# ------------------------------------------
# 4. Build and Production Artifacts
# ------------------------------------------
**/dist/
**/dist-ssr/
**/build/
dist/
build/

# ------------------------------------------
# 5. Log Files
# ------------------------------------------
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# 6. IDE / Editor / System Files
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
